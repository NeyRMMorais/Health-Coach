rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.email_verified == null || 
        !('email_verified' in request.auth.token)
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // UserProfile Helper
    function isValidUserProfile(data) {
      return data.userId == request.auth.uid &&
             (data.dailyCaloricLimit is int || data.dailyCaloricLimit is float) &&
             data.dailyCaloricLimit >= 500 &&
             data.dailyCaloricLimit <= 10000 &&
             (data.proteinTarget is int || data.proteinTarget is float) &&
             data.proteinTarget >= 0 &&
             data.proteinTarget <= 1000 &&
             (data.carbsTarget is int || data.carbsTarget is float) &&
             data.carbsTarget >= 0 &&
             data.carbsTarget <= 1000 &&
             (data.fatsTarget is int || data.fatsTarget is float) &&
             data.fatsTarget >= 0 &&
             data.fatsTarget <= 1000 &&
             data.weight is number &&
             data.weight >= 0.0 &&
             data.weight <= 500.0 &&
             data.targetWeight is number &&
             data.targetWeight >= 0.0 &&
             data.targetWeight <= 500.0 &&
             data.dietaryPreferences is list &&
             data.dietaryPreferences.size() <= 10 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // FoodLog Helper
    function isValidFoodLog(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 128 &&
             data.mealType is string &&
             (data.mealType == 'Breakfast' || data.mealType == 'Lunch' || data.mealType == 'Dinner' || data.mealType == 'Snack') &&
             (data.calories is int || data.calories is float) &&
             data.calories >= 0 &&
             data.calories <= 5000 &&
             (data.protein is int || data.protein is float) &&
             data.protein >= 0 &&
             data.protein <= 500 &&
             (data.carbs is int || data.carbs is float) &&
             data.carbs >= 0 &&
             data.carbs <= 500 &&
             (data.fats is int || data.fats is float) &&
             data.fats >= 0 &&
             data.fats <= 500 &&
             data.date is string &&
             data.date.size() == 10 &&
             data.time is string &&
             data.time.size() == 5 &&
             data.time.matches('^[0-9]{2}:[0-9]{2}$') &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // Feedback Helper
    function isValidFeedback(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.type is string &&
             (data.type == 'bug' || data.type == 'improvement') &&
             data.text is string &&
             data.text.size() > 0 &&
             data.text.size() <= 2000 &&
             data.createdAt is timestamp;
    }

    // SavedMeal Helper
    function isValidSavedMeal(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 128 &&
             data.mealType is string &&
             (data.mealType == 'Breakfast' || data.mealType == 'Lunch' || data.mealType == 'Dinner' || data.mealType == 'Snack') &&
             (data.calories is int || data.calories is float) &&
             data.calories >= 0 &&
             data.calories <= 5000 &&
             (data.protein is int || data.protein is float) &&
             data.protein >= 0 &&
             data.protein <= 500 &&
             (data.carbs is int || data.carbs is float) &&
             data.carbs >= 0 &&
             data.carbs <= 500 &&
             (data.fats is int || data.fats is float) &&
             data.fats >= 0 &&
             data.fats <= 500 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isEmailVerified() &&
                       isValidId(userId) &&
                       userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'dailyCaloricLimit', 'proteinTarget', 'carbsTarget', 'fatsTarget', 'weight', 'targetWeight', 'dietaryPreferences', 'createdAt', 'updatedAt']) &&
                       incoming().keys().size() == 10 &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time &&
                       isValidUserProfile(incoming());

      allow update: if isEmailVerified() &&
                       isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().updatedAt == request.time &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().userId == existing().userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['dailyCaloricLimit', 'proteinTarget', 'carbsTarget', 'fatsTarget', 'weight', 'targetWeight', 'dietaryPreferences', 'updatedAt']);

      allow delete: if isOwner(userId);

      match /foodLogs/{logId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isEmailVerified() &&
                          isValidId(userId) &&
                          isValidId(logId) &&
                          isOwner(userId) &&
                          incoming().id == logId &&
                          incoming().userId == request.auth.uid &&
                          incoming().keys().hasAll(['id', 'userId', 'name', 'mealType', 'calories', 'protein', 'carbs', 'fats', 'date', 'time', 'createdAt', 'updatedAt']) &&
                          incoming().keys().size() == 12 &&
                          incoming().createdAt == request.time &&
                          incoming().updatedAt == request.time &&
                          isValidFoodLog(incoming());

        allow update: if isEmailVerified() &&
                          isValidId(userId) &&
                          isValidId(logId) &&
                          isOwner(userId) &&
                          incoming().updatedAt == request.time &&
                          incoming().createdAt == existing().createdAt &&
                          incoming().id == existing().id &&
                          incoming().userId == existing().userId &&
                          isValidFoodLog(incoming()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'mealType', 'calories', 'protein', 'carbs', 'fats', 'date', 'time', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /savedMeals/{mealId} {
        allow get: if isSignedIn() && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isEmailVerified() &&
                          isValidId(userId) &&
                          isValidId(mealId) &&
                          isOwner(userId) &&
                          incoming().id == mealId &&
                          incoming().userId == request.auth.uid &&
                          incoming().keys().hasAll(['id', 'userId', 'name', 'mealType', 'calories', 'protein', 'carbs', 'fats', 'createdAt', 'updatedAt']) &&
                          incoming().keys().size() == 10 &&
                          incoming().createdAt == request.time &&
                          incoming().updatedAt == request.time &&
                          isValidSavedMeal(incoming());

        allow update: if isEmailVerified() &&
                          isValidId(userId) &&
                          isValidId(mealId) &&
                          isOwner(userId) &&
                          incoming().updatedAt == request.time &&
                          incoming().createdAt == existing().createdAt &&
                          incoming().id == existing().id &&
                          incoming().userId == existing().userId &&
                          isValidSavedMeal(incoming()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'mealType', 'calories', 'protein', 'carbs', 'fats', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn() &&
                       isValidId(feedbackId) &&
                       incoming().id == feedbackId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['id', 'userId', 'type', 'text', 'createdAt']) &&
                       incoming().keys().size() == 5 &&
                       incoming().createdAt == request.time &&
                       isValidFeedback(incoming());
      allow read, update, delete: if false;
    }
  }
}
